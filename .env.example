# Salin file ini menjadi .env lalu isi nilainya. Jangan unggah .env ke repo.
# PRD: bagian 4.6

# Application
APP_NAME="Portal Info Peserta"
APP_ENV=development
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portal_info_peserta
DB_USER=root
DB_PASSWORD=

# Session
SESSION_NAME=pip_session
REMEMBER_COOKIE=pip_remember
REMEMBER_DAYS=30
ADMIN_IDLE_MINUTES=120

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Export
CSV_DELIMITER=;
